FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
RUN addgroup --system metroguard && adduser --system --ingroup metroguard metroguard
COPY requirements.lock pyproject.toml README.md LICENSE ./
COPY src ./src
COPY configs ./configs
COPY artifacts/release ./artifacts/release
COPY reports/metrics.json ./reports/metrics.json
RUN python -m pip install --upgrade pip && \
    pip install -r requirements.lock && \
    pip install -e . --no-deps
USER metroguard
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"
CMD ["uvicorn", "metroguard.api:app", "--host", "0.0.0.0", "--port", "8000"]

