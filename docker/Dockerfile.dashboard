FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
RUN addgroup --system metroguard && adduser --system --ingroup metroguard metroguard
COPY requirements.lock pyproject.toml README.md LICENSE ./
COPY src ./src
COPY configs ./configs
COPY artifacts/release ./artifacts/release
COPY reports ./reports
COPY data/demo ./data/demo
RUN python -m pip install --upgrade pip && \
    pip install -r requirements.lock && \
    pip install -e . --no-deps
USER metroguard
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=2)"
CMD ["streamlit", "run", "src/metroguard/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]

